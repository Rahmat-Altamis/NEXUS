# NEXUS environment template — copy to .env and fill in. Never commit .env.
# Synthetic data only. No secrets in code. No real PII.

# 32-byte key, urlsafe-base64 (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Also accepts standard-b64 / hex / raw 32-byte forms. Dev fallback is insecure — always set this.
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# SQLite default; path to Postgres, e.g. postgresql+psycopg2://user:pass@localhost:5432/nexus
DATABASE_URL=sqlite:///./nexus.db

# mock (default, offline extractive) | http (requires LLM_API_URL below)
LLM_PROVIDER=mock

# Optional external LLM (used only when LLM_PROVIDER=http); transport errors fall back to mock
# LLM_API_URL=
# LLM_API_KEY=

# local (default, dependency-free) | chroma (requires optional chromadb install)
EMBEDDING_PROVIDER=local

# JWT signing (HS256); use 32+ random bytes in production
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET_32BYTES_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated CORS origins for the frontend dev server / deployment
FRONTEND_URL=http://localhost:5173
